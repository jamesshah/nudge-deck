// Staging / TestFlight backend. Release archives (Xcode Cloud TestFlight) use this file.
// "//" starts a comment in xcconfig files, so the URL is split with $() to keep it intact.
CONVEX_URL = https:/$()/loyal-lapwing-231.convex.cloud

// Name-only test sign-in. Release builds compile it out whatever this says.
ENABLE_DEV_SIGNIN = NO
ENABLE_DEV_SIGNIN[config=Debug] = YES

// Apple Developer Team ID (not secret). Required for device/Archive signing locally
// and helps Xcode Cloud managed signing. Override in Local.xcconfig only if needed.
DEVELOPMENT_TEAM = XH448HPM8W

// Optional Local.xcconfig (gitignored) overrides, e.g. local Convex:
//   CONVEX_URL = http:/$()/127.0.0.1:3210
// For a future App Store backend, use Config/Production.xcconfig + an AppStore
// Xcode configuration (see README "Staging vs production Convex").
#include? "Local.xcconfig"
