// App Store production backend. Used by the AppStore configuration /
// NudgeDeckAppStore scheme. Keep Release pointed at App.xcconfig for TestFlight.
//
// Set CONVEX_URL to the production Convex deployment before shipping.
// "//" starts a comment in xcconfig files, so the URL is split with $() to keep it intact.
CONVEX_URL = https:/$()/woozy-chihuahua-280.convex.cloud

ENABLE_DEV_SIGNIN = NO
DEVELOPMENT_TEAM = XH448HPM8W

// PostHog analytics (public client token; not a secret).
// Staging App.xcconfig omits these; set them here or in Local.xcconfig.
POSTHOG_PROJECT_TOKEN = phc_xtgCStgfkk5MX6TwmZVCVMRvJdYPEFvMPrjGkNh85CjA
POSTHOG_HOST = https:/$()/us.i.posthog.com
